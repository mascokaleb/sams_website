{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["sanity"]
  },
  "include": [
    "sanity.config.ts",
    "sanity.cli.ts",
    "schemaTypes/**/*",
    "structure.ts"
  ]
}
